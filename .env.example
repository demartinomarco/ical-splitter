# Replace these example URLs with your actual iCalendar subscription URLs.
# Treat them as secrets if they contain private subscription tokens.
FIRST_ICAL_URL=https://example.invalid/first.ics
SECOND_ICAL_URL=https://example.invalid/second.ics

# Optional. Go duration, e.g. 5m, 30m, or 1h.
REFRESH_INTERVAL=10m

# Generate each independently with: openssl rand -hex 32
FIRST_ENDPOINT_SECRET=
SECOND_ENDPOINT_SECRET=
SHARED_ENDPOINT_SECRET=
